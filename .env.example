# Required Vercel server environment variables. Never use a VITE_ prefix.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SECRET_KEY=""

# Optional. The API generates a per-instance random salt when this is unset.
# If you add one, generate it locally with a password manager and store it in Vercel only.
KIRI_RATE_LIMIT_SALT=""

# Optional. Leave unset for same-origin requests and the default table name.
KIRI_ALLOWED_ORIGINS=""
KIRI_PREREGISTER_TABLE="kiri_preregistrations"

# Required to publish /.well-known/assetlinks.json.
# Paste the SHA-256 fingerprint of the Play Console app signing key certificate.
# When empty or invalid, the endpoint returns 503 and publishes no relation file.
KIRI_ANDROID_SHA256_CERT_FINGERPRINT=""

# Public browser analytics identifiers. Set production values in Vercel Production only.
VITE_GA4_MEASUREMENT_ID=""
VITE_HACKLE_BROWSER_SDK_KEY=""

# Server-only. The inquiry API requires an approved retention period.
# Origin, policy version, and rate salt have defaults and can be overridden.
HALO_PARTNERSHIP_ORIGIN=""
HALO_PARTNERSHIP_POLICY_VERSION=""
HALO_PARTNERSHIP_RETENTION_DAYS=""
HALO_PARTNERSHIP_RATE_SALT=""
