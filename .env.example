# Required Vercel server environment variables. Never use a VITE_ prefix.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SECRET_KEY=""

# Optional. The API generates a per-instance random salt when this is unset.
# If you add one, generate it locally with a password manager and store it in Vercel only.
KIRI_RATE_LIMIT_SALT=""

# Optional. Leave unset for same-origin requests and the default table name.
KIRI_ALLOWED_ORIGINS=""
KIRI_PREREGISTER_TABLE="kiri_preregistrations"

# Public browser analytics identifiers. Set production values in Vercel Production only.
VITE_GA4_MEASUREMENT_ID=""
VITE_HACKLE_BROWSER_SDK_KEY=""
